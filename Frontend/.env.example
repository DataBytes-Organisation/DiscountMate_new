# Frontend build-time configuration
# Set this to the deployed backend API base URL, including /api.
# Cloud Run example:
# EXPO_PUBLIC_API_URL=https://webdev-backend-xxxxx.australia-southeast1.run.app/api
EXPO_PUBLIC_API_URL=http://localhost:3000/api

# Comparison stays unavailable unless this build-time flag is explicitly true.
# Local comparison development also requires DE_DATABASE_URL and APP_DATABASE_URL
# in Backend/.env.
EXPO_PUBLIC_COMPARISON_V2_ENABLED=false

# Public OAuth client identifiers only. Never place a Google client secret here.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
